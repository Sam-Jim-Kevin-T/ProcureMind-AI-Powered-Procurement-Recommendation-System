# Copy this file to .env and fill provider credentials.

# PostgreSQL persistence (required)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/procuremind_db

# Default LLM provider in API/orchestration is Bedrock.
# For short-lived AWS credentials (3-6 hours), refresh these values as needed.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token
AWS_REGION=us-east-1

# Optional Bedrock model override
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional fallback order when a model is retired/unavailable
BEDROCK_FALLBACK_MODELS=anthropic.claude-3-5-sonnet-20241022-v2:0,anthropic.claude-3-haiku-20240307-v1:0

# Optional OpenAI fallback (if llm_provider=openai is used)
OPENAI_API_KEY=your_openai_secret_key_here
OPENAI_MODEL=gpt-4.1-mini
